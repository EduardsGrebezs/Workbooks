    "principalIdDisplayName": "Squalio SOC L2 Support"
   },
   {
    "principalId": "b15560da-4cda-4f6e-bd47-ff873521bd98",
    "roleDefinitionId": "51d6186e-6489-4900-b93f-92e23144cca5",
    "principalIdDisplayName": "Squalio SOC L2 Support"
   },
   {
    "principalId": "b15560da-4cda-4f6e-bd47-ff873521bd98",
    "roleDefinitionId": "87a39d53-fc1b-424a-814c-f7e04687dc9e",
    "principalIdDisplayName": "Squalio SOC L2 Support"
   },
   {
    "principalId": "8951b08c-673c-4984-b397-e418e7bf4838",
    "roleDefinitionId": "acdd72a7-3385-48ef-bd42-f606fba81ae7",
    "principalIdDisplayName": "Squalio SOC L1 Support"
   },
   {
