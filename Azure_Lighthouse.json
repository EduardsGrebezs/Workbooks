{
 "$schema": "https://schema.management.azure.com/schemas/2019-08-01/subscriptionDeploymentTemplate.json#",
 "contentVersion": "1.0.0.0",
 "parameters": {
  "mspOfferName": {
   "type": "string",
   "metadata": {
    "description": "Specify a unique name for your offer"
   },
   "defaultValue": "Squalio Managed XDR services"
  },
  "mspOfferDescription": {
   "type": "string",
   "metadata": {
    "description": "Name of the Managed Service Provider offering"
   },
   "defaultValue": "Microsoft Defender XDR and Microsoft Sentinel security operations center (SOC)"
  },
  "rgName": {
   "type": "string",
   "defaultValue": "{Sentinel-Rg-Name}"
  }
 },
 "variables": {
  "mspRegistrationName": "[guid(parameters('mspOfferName'))]",
  "mspAssignmentName": "[guid(parameters('mspOfferName'))]",
  "managedByTenantId": "119cfc3c-8215-4804-8950-6388c0e14143",
  "authorizations": [
   {
    "principalId": "b15560da-4cda-4f6e-bd47-ff873521bd98",
