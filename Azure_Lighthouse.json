   },
   {
    "principalId": "8951b08c-673c-4984-b397-e418e7bf4838",
    "roleDefinitionId": "8d289c81-5878-46d4-8554-54e1e3d8b5cb",
    "principalIdDisplayName": "Squalio SOC L1 Support"
   },
   {
    "principalId": "8951b08c-673c-4984-b397-e418e7bf4838",
